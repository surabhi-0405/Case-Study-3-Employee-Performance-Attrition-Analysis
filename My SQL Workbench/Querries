-- ============================================================
-- 01. OVERALL WORKFORCE KPIs
-- ============================================================

SELECT
    COUNT(*) AS Total_Employees,

    SUM(CASE
        WHEN f.Attrition_Status = 'Attrited' THEN 1
        ELSE 0
    END) AS Attrited_Employees,

    SUM(CASE
        WHEN f.Attrition_Status = 'Not Attrited' THEN 1
        ELSE 0
    END) AS Not_Attrited_Employees,

    SUM(CASE
        WHEN f.Attrition_Status = 'Unknown' THEN 1
        ELSE 0
    END) AS Unknown_Attrition_Employees,

    ROUND(
        100.0 *
        SUM(CASE
            WHEN f.Attrition_Status = 'Attrited' THEN 1
            ELSE 0
        END)
        /
        NULLIF(
            SUM(CASE
                WHEN f.Attrition_Status IN ('Attrited', 'Not Attrited')
                THEN 1
                ELSE 0
            END),
            0
        ),
        2
    ) AS Attrition_Rate_Percent,

    ROUND(
        100.0 *
        SUM(CASE
            WHEN f.Attrition_Status = 'Not Attrited' THEN 1
            ELSE 0
        END)
        /
        NULLIF(
            SUM(CASE
                WHEN f.Attrition_Status IN ('Attrited', 'Not Attrited')
                THEN 1
                ELSE 0
            END),
            0
        ),
        2
    ) AS Retention_Rate_Percent,

    ROUND(AVG(e.Job_Tenure), 2) AS Average_Tenure,

    ROUND(AVG(f.Performance_Rating), 2) AS Average_Performance_Rating,

    ROUND(AVG(f.Overall_Satisfaction_Score), 2) AS Average_Satisfaction,

    ROUND(AVG(f.Training_Hours), 2) AS Average_Training_Hours

FROM fact_employee_performance f

INNER JOIN dim_employee e
    ON f.Employee_Key = e.Employee_Key;
