    COUNT(*) AS Employee_Count
FROM stg_employee_attrition
GROUP BY Attrition_Status
ORDER BY Attrition_Status;
------------------------------------------------------------------------
-- ============================================================
-- CREATE DIMENSION TABLES
-- ============================================================

-- 1. Employee Dimension
CREATE TABLE dim_employee (
    Employee_Key INT AUTO_INCREMENT PRIMARY KEY,
    Employee_ID INT NOT NULL UNIQUE,
    Age INT,
    Gender_Detail VARCHAR(30),
    Gender_Group VARCHAR(20),
    Education_Level VARCHAR(50),
    Marital_Status VARCHAR(30),
    Job_Tenure INT,
    Tenure_Group VARCHAR(20),
    Distance_From_Home INT,
    Distance_Group VARCHAR(20)
);

-- 2. Department Dimension
CREATE TABLE dim_department (
    Department_Key INT AUTO_INCREMENT PRIMARY KEY,
    Department VARCHAR(50) NOT NULL UNIQUE
);

-- 3. Job Role Dimension
CREATE TABLE dim_job_role (
    Job_Role_Key INT AUTO_INCREMENT PRIMARY KEY,
    Job_Role VARCHAR(50) NOT NULL UNIQUE
);
------------------------------------------------------------------------
-- ============================================================
-- POPULATE DIMENSION TABLES
-- ============================================================

-- 1. Populate Employee Dimension
INSERT INTO dim_employee (
    Employee_ID,
    Age,
    Gender_Detail,
    Gender_Group,
    Education_Level,
    Marital_Status,
    Job_Tenure,
    Tenure_Group,
    Distance_From_Home,
    Distance_Group
)
SELECT
    Employee_ID,
    Age,
    Gender_Detail,
    Gender_Group,
    Education_Level,
    Marital_Status,
    Job_Tenure,
    Tenure_Group,
    Distance_From_Home,
    Distance_Group
FROM stg_employee_attrition;


-- 2. Populate Department Dimension
INSERT INTO dim_department (Department)
SELECT DISTINCT
    Department
FROM stg_employee_attrition
WHERE Department IS NOT NULL
ORDER BY Department;


-- 3. Populate Job Role Dimension
INSERT INTO dim_job_role (Job_Role)
SELECT DISTINCT
    Job_Role
FROM stg_employee_attrition
WHERE Job_Role IS NOT NULL
ORDER BY Job_Role;
------------------------------------------------------------------------
-- ============================================================
-- STEP 10: CREATE FACT TABLE
-- ============================================================

CREATE TABLE fact_employee_performance (
    Fact_Key INT AUTO_INCREMENT PRIMARY KEY,

    Employee_Key INT NOT NULL,
    Department_Key INT NOT NULL,
    Job_Role_Key INT NOT NULL,

    Performance_Rating INT,
    Performance_Category VARCHAR(20),

    Last_Promotion_Year INT,
    Years_Since_Last_Promotion INT,

    Training_Hours INT,
    Training_Level VARCHAR(20),

    Work_Life_Balance INT,
    Job_Satisfaction INT,
    Overall_Satisfaction_Score DECIMAL(4,2),

    Attrition BOOLEAN NULL,
    Attrition_Status VARCHAR(20),
    Attrition_Available TINYINT,

    Exit_Interview_Score INT NULL,

    CONSTRAINT fk_fact_employee
        FOREIGN KEY (Employee_Key)
        REFERENCES dim_employee(Employee_Key),

    CONSTRAINT fk_fact_department
        FOREIGN KEY (Department_Key)
        REFERENCES dim_department(Department_Key),

    CONSTRAINT fk_fact_job_role
        FOREIGN KEY (Job_Role_Key)
        REFERENCES dim_job_role(Job_Role_Key)
);
------------------------------------------------------------------------
-- ============================================================
-- STEP 11: POPULATE FACT TABLE
-- ============================================================

INSERT INTO fact_employee_performance (
    Employee_Key,
    Department_Key,
    Job_Role_Key,
    Performance_Rating,
    Performance_Category,
    Last_Promotion_Year,
    Years_Since_Last_Promotion,
    Training_Hours,
    Training_Level,
    Work_Life_Balance,
    Job_Satisfaction,
    Overall_Satisfaction_Score,
    Attrition,
    Attrition_Status,
    Attrition_Available,
    Exit_Interview_Score
)
SELECT
    e.Employee_Key,
    d.Department_Key,
    r.Job_Role_Key,

    s.Performance_Rating,
    s.Performance_Category,

    s.Last_Promotion_Year,
    s.Years_Since_Last_Promotion,

    s.Training_Hours,
    s.Training_Level,

    s.Work_Life_Balance,
    s.Job_Satisfaction,
    s.Overall_Satisfaction_Score,

    CASE
        WHEN s.attrition = 'True' THEN 1
        WHEN s.attrition = 'False' THEN 0
        ELSE NULL
    END AS Attrition,

    s.Attrition_Status,
    s.Attrition_Available,

    CASE
        WHEN TRIM(s.Exit_Interview_Score) = '' THEN NULL
        ELSE CAST(s.Exit_Interview_Score AS UNSIGNED)
    END AS Exit_Interview_Score

FROM stg_employee_attrition s

INNER JOIN dim_employee e
    ON s.Employee_ID = e.Employee_ID

INNER JOIN dim_department d
    ON s.Department = d.Department

INNER JOIN dim_job_role r
    ON s.Job_Role = r.Job_Role;
------------------------------------------------------------------------

INSERT INTO fact_employee_performance (
    Employee_Key,
    Department_Key,
    Job_Role_Key,
    Performance_Rating,
    Performance_Category,
    Last_Promotion_Year,
    Years_Since_Last_Promotion,
    Training_Hours,
    Training_Level,
    Work_Life_Balance,
    Job_Satisfaction,
    Overall_Satisfaction_Score,
    Attrition,
    Attrition_Status,
    Attrition_Available,
    Exit_Interview_Score
)
SELECT
    e.Employee_Key,
    d.Department_Key,
    r.Job_Role_Key,

    s.Performance_Rating,
    s.Performance_Category,

    s.Last_Promotion_Year,
    s.Years_Since_Last_Promotion,

    s.Training_Hours,
    s.Training_Level,

    s.Work_Life_Balance,
    s.Job_Satisfaction,
    s.Overall_Satisfaction_Score,

    CASE
        WHEN LOWER(TRIM(s.attrition)) = 'true' THEN 1
        WHEN LOWER(TRIM(s.attrition)) = 'false' THEN 0
        ELSE NULL
    END AS Attrition,

    s.Attrition_Status,
    s.Attrition_Available,

    CASE
        WHEN TRIM(s.Exit_Interview_Score) = ''
             OR s.Exit_Interview_Score IS NULL
        THEN NULL
        ELSE CAST(CAST(s.Exit_Interview_Score AS DECIMAL(10,2)) AS UNSIGNED)
    END AS Exit_Interview_Score

FROM stg_employee_attrition s

INNER JOIN dim_employee e
    ON s.Employee_ID = e.Employee_ID

INNER JOIN dim_department d
    ON s.Department = d.Department

INNER JOIN dim_job_role r
    ON s.Job_Role = r.Job_Role;
------------------------------------------------------------------------

SELECT
    COUNT(*) AS Total_Fact_Rows,
    COUNT(e.Employee_Key) AS Matched_Employees,
    COUNT(d.Department_Key) AS Matched_Departments,
    COUNT(r.Job_Role_Key) AS Matched_Job_Roles
FROM fact_employee_performance f
LEFT JOIN dim_employee e
    ON f.Employee_Key = e.Employee_Key
LEFT JOIN dim_department d
    ON f.Department_Key = d.Department_Key
LEFT JOIN dim_job_role r
    ON f.Job_Role_Key = r.Job_Role_Key;
