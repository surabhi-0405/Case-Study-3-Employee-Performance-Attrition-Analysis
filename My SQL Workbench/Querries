USE employee_attrition_dw;

CREATE TABLE stg_employee_attrition (
    Employee_ID INT,
    Age INT,

    -- Original CSV columns: gender and Gender
    -- Renamed because MySQL treats names as case-insensitive
    Gender_Detail VARCHAR(30),
    Gender_Group VARCHAR(20),

    Department VARCHAR(50),
    Job_Role VARCHAR(50),
    Education_Level VARCHAR(50),
    Marital_Status VARCHAR(30),

    Job_Tenure INT,
    Tenure_Group VARCHAR(20),

    Distance_From_Home INT,
    Distance_Group VARCHAR(20),

    Performance_Rating INT,
    Performance_Category VARCHAR(20),

    Last_Promotion_Year INT,
    Years_Since_Last_Promotion INT,

    Training_Hours INT,
    Training_Level VARCHAR(20),

    Work_Life_Balance INT,
    Job_Satisfaction INT,

    Overall_Satisfaction_Score DECIMAL(4,2),

    -- Kept as text in staging because CSV contains blanks
    attrition VARCHAR(10),
    Attrition_Status VARCHAR(20),

    Attrition_Available TINYINT,

    -- Kept as text in staging because 879 records are blank
    Exit_Interview_Score VARCHAR(10)
);

SHOW COLUMNS FROM stg_employee_attrition;
------------------------------------------------------------------------
SELECT
    SUM(Employee_ID IS NULL) AS Missing_Employee_ID,
    SUM(Age IS NULL) AS Missing_Age,
    SUM(Department IS NULL) AS Missing_Department,
    SUM(Job_Role IS NULL) AS Missing_Job_Role,
    SUM(Job_Tenure IS NULL) AS Missing_Job_Tenure,
    SUM(Performance_Rating IS NULL) AS Missing_Performance_Rating,
    SUM(Training_Hours IS NULL) AS Missing_Training_Hours,
    SUM(Work_Life_Balance IS NULL) AS Missing_Work_Life_Balance,
    SUM(Job_Satisfaction IS NULL) AS Missing_Job_Satisfaction,
    SUM(attrition IS NULL OR attrition = '') AS Missing_Attrition,
    SUM(Exit_Interview_Score IS NULL OR Exit_Interview_Score = '') AS Missing_Exit_Interview_Score
FROM stg_employee_attrition;
------------------------------------------------------------------------
SELECT
